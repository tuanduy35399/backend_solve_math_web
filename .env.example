DJANGO_DEBUG=true
# Generate a random value before deployment; blank uses a local generated secret.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional: a separate database path. Default: db.sqlite3
DATABASE_PATH=
AI_TIMEOUT_SECONDS=90
# Material generation only. Never used for tutoring or student photos.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_DAILY_LIMIT=100
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
CHROMA_DB_PATH=./data/chroma
CHROMA_COLLECTION=mindgeo_geometry
# Set true after installing requirements-ai.txt; run import_geometry_corpus then sync_geometry_index.
RAG_ENABLED=false
# Keep false for the first BGE-M3 download; true loads only cached weights afterwards.
RAG_MODEL_OFFLINE=false
RAG_EMBED_MAX_LENGTH=2048
RAG_CPU_THREADS=2
# Shared by the Socratic tutor chat (text + student photos) and the research agent.
# The model must support vision (image_url) for photo questions.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
TAVILY_API_KEY=
# External model for summaries, exercises and quizzes: gemini or openai
CONTENT_PROVIDER=gemini
